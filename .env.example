# Copy to .env and fill in for local development.
# Read by aic_database.session.DatabaseSettings and by Alembic (packages/database/alembic/env.py).
# Also required by `make demo-up`/`demo-deploy-*` (apps/toy-ops): the deploy
# script writes each toy-system redeploy as a real row in this database's
# `deployment` table. This is AIC's own system-of-record Postgres — a
# separate, host-reachable instance, not the toy Postgres running inside
# the kind cluster for payment-service (see infra/kind/postgres.yaml).
AIC_DATABASE_URL=postgresql+psycopg://aic:aic@localhost:5432/aic

# LiteLLM proxy (T5, ADR 0004; see infra/litellm/litellm_config.yaml).
# ANTHROPIC_API_KEY is read by the litellm proxy container itself
# (`make llm-up`), not by AIC's own code.
ANTHROPIC_API_KEY=sk-ant-...
# LITELLM_MASTER_KEY (read by the proxy container) and AIC_LITELLM_MASTER_KEY
# (read by aic_agents.config.LiteLLMSettings, the client side) must be the
# same value — it's the Bearer token the proxy checks incoming requests
# against. Any non-guessable local string is fine; this never needs to be a
# real provider credential.
LITELLM_MASTER_KEY=sk-aic-local-dev
AIC_LITELLM_MASTER_KEY=sk-aic-local-dev

# Approval workflow (T9, design doc §1.10). No broader identity provider
# exists in this project, so aic-approval-api's Bearer-token auth is a
# static token -> {decider_id, roles} map. Any non-guessable local string
# is fine as the token for this milestone.
AIC_APPROVAL_API_IDENTITIES={"sk-aic-sre-local-dev":{"decider_id":"local-sre","roles":["sre"]}}

# `aic approve <incident-id>` (the CLI surface) talks to Postgres directly
# rather than over HTTP (see apps/aic-cli's module docstring), so it reads
# the deciding human's identity straight from the environment instead.
AIC_CLI_DECIDER_ID=local-sre
AIC_CLI_DECIDER_ROLES=sre
